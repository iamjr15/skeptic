{
  "name": "skeptic-cli",
  "version": "0.2.0",
  "description": "CLI E2E testing for AI agents — TypeScript test runner with AI assertions, observability, and snapshot-based discovery",
  "type": "module",
  "bin": {
    "skeptic": "bin/launcher.mjs"
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.ts"
    },
    "./test": {
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.ts"
    },
    "./engine": {
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsc --noEmit",
    "clean": "rm -rf dist",
    "postinstall": "node ./scripts/install-agent-skills.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "agent-skills",
    "dist",
    "bin/launcher.mjs",
    "scripts/install-agent-skills.mjs",
    "README.md",
    "AGENTS.md",
    "LICENSES.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iamjr15/skeptic.git"
  },
  "homepage": "https://github.com/iamjr15/skeptic",
  "author": "iamjr15",
  "keywords": [
    "testing",
    "e2e",
    "playwright",
    "typescript",
    "cli",
    "ai",
    "agents",
    "browser"
  ],
  "license": "MIT",
  "dependencies": {
    "@playwright/test": "^1.59.1",
    "cli-truncate": "^5.2.0",
    "fast-glob": "^3.3.2",
    "figures": "^6.1.0",
    "ink": "^7.0.2",
    "ink-spinner": "^5.0.0",
    "oxc-resolver": "^11.19.1",
    "playwright": "^1.52.0",
    "playwright-core": "^1.52.0",
    "pretty-ms": "^9.3.0",
    "react": "^19.2.6",
    "string-width": "^8.2.1",
    "tsx": "^4.19.0",
    "typescript": "^5.8.3"
  },
  "optionalDependencies": {
    "accessibility-checker-engine": "^4.0.0",
    "better-sqlite3": "^12.9.0"
  },
  "devDependencies": {
    "@agentclientprotocol/sdk": "^0.20.0",
    "@axe-core/playwright": "^4.11.2",
    "@faker-js/faker": "^9.0.0",
    "@google/generative-ai": "^0.24.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.3",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.14",
    "chalk": "^5.4.1",
    "chokidar": "^5.0.0",
    "commander": "^13.1.0",
    "fast-xml-parser": "^5.2.3",
    "glob": "^11.0.2",
    "ink-testing-library": "^4.0.0",
    "minimatch": "^10.0.0",
    "pixelmatch": "^7.1.0",
    "pngjs": "^7.0.0",
    "tsup": "^8.5.1",
    "vitest": "^3.1.2",
    "web-vitals": "^4.2.4",
    "yaml": "^2.7.1",
    "zod": "^3.24.4"
  }
}
