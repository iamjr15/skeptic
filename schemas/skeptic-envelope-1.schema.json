{
  "$defs": {
    "ApiError": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string"
        },
        "hint": {
          "type": [
            "string",
            "null"
          ]
        },
        "message": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "type": "object"
    },
    "EnvelopeMeta": {
      "additionalProperties": false,
      "properties": {
        "cursor": {
          "type": [
            "string",
            "null"
          ]
        },
        "durationMs": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "schema": {
          "type": "string"
        },
        "sideEffects": {
          "$ref": "#/$defs/SideEffects"
        },
        "total": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "truncated": {
          "type": "boolean"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "schema",
        "version",
        "durationMs",
        "sideEffects",
        "truncated"
      ],
      "type": "object"
    },
    "SideEffects": {
      "enum": [
        "none",
        "possible",
        "committed"
      ],
      "type": "string"
    },
    "Warning": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "type": "object"
    }
  },
  "$id": "skeptic.envelope/1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "data": true,
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/ApiError"
        },
        {
          "type": "null"
        }
      ]
    },
    "meta": {
      "$ref": "#/$defs/EnvelopeMeta"
    },
    "ok": {
      "type": "boolean"
    },
    "warnings": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Warning"
      },
      "type": "array"
    }
  },
  "required": [
    "ok",
    "meta"
  ],
  "title": "ResponseEnvelope",
  "type": "object",
  "x-skeptic-version": "2.0.0"
}
